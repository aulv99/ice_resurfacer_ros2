<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="ice_rink">

    <scene>
      <grid>false</grid>
    </scene>
    
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu"/>
    
    <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

   <model name="ice_sheet">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose> <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.25</mu> <mu2>0.25</mu2>
                <!-- 0.33 -->
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>model://ice_resurfacer_gazebo/materials/textures/Hockeyrink_IIHF_ads.png</albedo_map>
                <roughness>0.1</roughness> 
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="hall_concrete_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose> <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 80</size> </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu> <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1.0</ambient>
            <diffuse>0.6 0.6 0.6 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rink_mesh">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose> 
      <link name="link">
        
        <visual name="rink_visual">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/boards_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
          </material>
        </visual>
        <collision name="rink_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/boards_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

        <visual name="utilities_visual">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/buildings.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
          </material>
        </visual>
        <collision name="utilities_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/buildings.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

        <visual name="board_top_visual">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/boardtop_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.8 1.0</ambient>
            <diffuse>0.1 0.1 0.8 1.0</diffuse>
          </material>
        </visual>
        <collision name="board_top_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/boardtop_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

        <visual name="board_bottom_visual">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/boardbottom_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 1.0 0.0 1.0</ambient>
            <diffuse>1.0 1.0 0.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular> 
          </material>
        </visual>
        <collision name="board_bottom_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/boardbottom_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

        <visual name="plexi_visual">
          <transparent>true</transparent>
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/plexi_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.9 1.0 0.3</ambient>
            <diffuse>0.8 0.9 1.0 0.3</diffuse>
            
            <specular>0.9 0.9 0.9 0.3</specular>
            
            <pbr>
              <metal>
                <roughness>0.01</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="plexi_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/plexi_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

        <visual name="goal_visual">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/goal1_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="goal_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/goal1_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

        <visual name="goal2_visual">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/goal2_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1.0</ambient>
            <diffuse>0.8 0.1 0.1 1.0</diffuse>
          </material>
        </visual>
        <collision name="goal2_collision">
          <geometry>
            <mesh>
              <uri>model://ice_resurfacer_gazebo/meshes/goal2_260622.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

      </link>
    </model>
  </world>
</sdf>